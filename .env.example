# StudyBuddy Configuration
# Copy this file to .env and adjust variables as required.
# DO NOT commit real secrets or .env to version control.

# ==========================================
# LLM Backend Selection
# Options: mock | hf_local | ollama | cloud
# ==========================================
LLM_BACKEND=mock

# ==========================================
# Hugging Face Local Backend (hf_local)
# Used when running local Transformers with PEFT LoRA adapter
# ==========================================
HF_MODEL_NAME_OR_PATH=Qwen/Qwen2.5-0.5B-Instruct
LORA_ADAPTER_PATH=models/adapter/

# ==========================================
# Ollama Backend (ollama)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# ==========================================
# Cloud Backend (cloud)
# Supports any OpenAI-compatible API (OpenAI, Groq, OpenRouter, etc.)
# ==========================================
CLOUD_API_KEY=your_api_key_here
CLOUD_API_BASE=https://api.openai.com/v1
CLOUD_MODEL_NAME=gpt-4o-mini

# ==========================================
# Ingestion & Retrieval Configuration
# ==========================================
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
INDEX_PATH=indexes/faiss_index
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVER_K=3

# ==========================================
# Server & Logging Configuration
# ==========================================
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
MAX_QUESTION_LENGTH=1000
